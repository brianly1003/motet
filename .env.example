# Copy to .env (next to where you run meetnote) or ~/.config/meetnote/.env.
# These replace variables already set in the shell; ./.env wins over ~/.config/meetnote/.env.
WHISPER_MODEL=$HOME/.cache/whisper/ggml-large-v3-q5_0.bin
WHISPER_VAD_MODEL=$HOME/.cache/whisper/ggml-silero-v5.1.2.bin
OLLAMA_MODEL=qwen3:8b
# Optional: a local model that fixes misheard words before the summary, in any language.
# Small models (4-8B) rarely help; a chunk the model translates or rewrites is kept as transcribed.
# FIX_MODEL=gemma3:27b
# Optional: names and jargon whisper and the summary model may not know (new products, people,
# project codes), comma-separated. Both use these spellings. Add a common mishearing if needed.
# TERMS=Pusher Beams, FCM, Firebase Cloud Messaging, IGB
# Optional: transcripts longer than this many characters are summarized in parts, then merged.
# SUMMARY_CHUNK_CHARS=24000
# Only these keys are read from .env files; anything else (PATH, OLLAMA_HOST…) is ignored.
