{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Motet",
  "version": "0.1.0",
  "identifier": "local.motet.desktop",
  "build": {
    "frontendDist": "../../ui/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm --prefix ../../ui run dev",
    "beforeBuildCommand": "npm --prefix ../../ui run build"
  },
  "app": {
    "windows": [{"label":"main","title":"Motet","url":"main/","width":1020,"height":660,"minWidth":760,"minHeight":520}],
    "security": {"csp":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"}
  },
  "bundle": {"active":false}
}
